# =============================================================================
# Sixtyfour Demos — Environment variables
# =============================================================================
#
# Copy this file to `.env` at the repo root for local development.
# Never commit real values.
#
# This template covers the variables consumed by the site (apps/site) and the
# provisioning script (scripts/provision-workflows.ts). Each demo also has its
# own `.env.example` for running the standalone scripts.

# -----------------------------------------------------------------------------
# Required: Sixtyfour API key
# Get one at https://app.sixtyfour.ai/keys
# -----------------------------------------------------------------------------
SIXTYFOUR_API_KEY=

# -----------------------------------------------------------------------------
# Optional: API base URL override (defaults to https://api.sixtyfour.ai)
# Only set this if you have a private/staging Sixtyfour endpoint.
# -----------------------------------------------------------------------------
# SIXTYFOUR_API_BASE_URL=https://api.sixtyfour.ai

# -----------------------------------------------------------------------------
# Workflow IDs (populated by `pnpm provision`)
#
# These map a demo slug to the workflow_id created in your Sixtyfour account.
# After running `pnpm provision`, copy the printed env vars into here (or into
# your Vercel project's environment variables).
# -----------------------------------------------------------------------------
ICP_QUALIFIER_WORKFLOW_ID=
PASSIVE_CANDIDATE_FINDER_WORKFLOW_ID=
KYB_REPORT_WORKFLOW_ID=
THREAT_ACTOR_FOOTPRINT_WORKFLOW_ID=
FOUNDER_BACKGROUND_CHECK_WORKFLOW_ID=
COMPETITIVE_ORG_INTEL_WORKFLOW_ID=

# -----------------------------------------------------------------------------
# Optional site config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://demos.sixtyfour.ai
