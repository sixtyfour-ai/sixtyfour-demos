# =============================================================================
# Sixtyfour Demos — Environment variables
# =============================================================================
#
# Copy this file to `.env` at the repo root for local development.
# Never commit real values.
#
# The hosted site (demos.sixtyfour.ai) does NOT need SIXTYFOUR_API_KEY —
# visitors supply their own key via the browser settings panel (BYOK).
#
# You only need this file if you are running the site locally via `pnpm dev`
# and want to skip the in-browser key prompt, OR if you are running a
# standalone demo script (e.g. demos/sales-gtm/icp-qualifier/main.ts).

# -----------------------------------------------------------------------------
# Sixtyfour API key
# Get one at https://app.sixtyfour.ai/keys
# -----------------------------------------------------------------------------
SIXTYFOUR_API_KEY=

# -----------------------------------------------------------------------------
# Optional: API base URL override (defaults to https://api.sixtyfour.ai)
# Only set this if you have a private/staging Sixtyfour endpoint.
# -----------------------------------------------------------------------------
# SIXTYFOUR_API_BASE_URL=https://api.sixtyfour.ai

# -----------------------------------------------------------------------------
# Optional site config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://demos.sixtyfour.ai
