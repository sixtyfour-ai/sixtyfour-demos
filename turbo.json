{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "SIXTYFOUR_API_KEY",
    "SIXTYFOUR_API_BASE_URL",
    "ICP_QUALIFIER_WORKFLOW_ID",
    "PASSIVE_CANDIDATE_FINDER_WORKFLOW_ID",
    "KYB_REPORT_WORKFLOW_ID",
    "THREAT_ACTOR_FOOTPRINT_WORKFLOW_ID",
    "FOUNDER_BACKGROUND_CHECK_WORKFLOW_ID",
    "COMPETITIVE_ORG_INTEL_WORKFLOW_ID",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
