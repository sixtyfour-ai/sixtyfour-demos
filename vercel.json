{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo run build --filter=site",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/site/.next",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./apps/site ./packages ./demos ./scripts ./pnpm-lock.yaml ./package.json ./pnpm-workspace.yaml ./turbo.json ./vercel.json",
  "functions": {
    "apps/site/app/api/demo/*/run/route.ts": {
      "maxDuration": 300
    },
    "apps/site/app/api/demo/*/status/route.ts": {
      "maxDuration": 30
    }
  }
}
