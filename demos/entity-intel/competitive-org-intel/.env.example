# =============================================================================
# Competitive Org Intel — Environment variables
# =============================================================================
#
# Copy this file to `.env` and fill in your values.
# Never commit real values.

# Required: your Sixtyfour API key
# Get one at https://app.sixtyfour.ai/keys
SIXTYFOUR_API_KEY=

