# =============================================================================
# Founder Background Check — Environment variables
# =============================================================================
#
# Copy this file to `.env` and fill in your values.
# Never commit real values.

# Required: your Sixtyfour API key
# Get one at https://app.sixtyfour.ai/keys
SIXTYFOUR_API_KEY=

# Optional: founder to investigate (default: Saarth Shah)
# TARGET_NAME=Saarth Shah

# Optional: current or most recent company — disambiguates common names
# TARGET_COMPANY=Sixtyfour

# Optional: confirmed LinkedIn URL — anchors identity resolution
# TARGET_LINKEDIN=https://linkedin.com/in/saarthshah

# Optional: override API base URL (default: https://api.sixtyfour.ai)
# SIXTYFOUR_API_BASE_URL=https://api.sixtyfour.ai
